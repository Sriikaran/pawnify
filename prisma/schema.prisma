// Pawnify - Gold/Silver Pawn Broker Management System
// Prisma Schema - PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==================== ENUMS ====================

enum Role {
  ADMIN
  STAFF
}

enum MetalType {
  GOLD
  SILVER
  OTHER
}

enum LoanStatus {
  ACTIVE
  CLOSED
}

enum KycDocType {
  AADHAAR
  PAN
  VOTER_ID
  PASSPORT
  DRIVING_LICENSE
}

enum KycStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum PaymentMode {
  CASH
  UPI
  BANK_TRANSFER
  CARD
}

enum ChargeType {
  PROCESSING_FEE
  PENAL_CHARGE
  OTHER
}

enum TransactionType {
  DISBURSEMENT
  PAYMENT
  CLOSURE
  ITEM_RELEASE
  CANCELLATION
}

enum FollowUpStatus {
  PENDING
  DONE
  CANCELLED
}

enum AccountType {
  ASSET
  LIABILITY
  INCOME
  EXPENSE
  EQUITY
}

/// Interest type on a loan.
/// STANDARD: Simple interest, does not capitalize.
/// CUMULATIVE: Compound interest — interest may capitalize at configured intervals.
enum InterestType {
  STANDARD
  CUMULATIVE
}

/// How often interest accrues / resets for payment purposes.
enum InterestFrequency {
  DAILY
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY
  CUSTOM
}

/// For CUMULATIVE loans: what happens to accrued interest at each period end.
/// ADD_TO_CAPITAL: Accrued interest is capitalized (added to principal).
/// KEEP_SEPARATE: Accrued interest remains separate; principal is not increased.
enum CumulativeInterestTreatment {
  ADD_TO_CAPITAL
  KEEP_SEPARATE
}

/// The explicit type of a payment — controls allocation waterfall.
enum PaymentType {
  /// Full waterfall: charges → interest → principal
  FULL
  /// Reduce interest only; principal unchanged
  INTEREST_ONLY
  /// Reduce principal only; unpaid interest remains due
  PRINCIPAL_ONLY
  /// Partial payment against total outstanding (standard waterfall, does not close loan)
  PART_PAYMENT
  /// Full settlement + closure
  CLOSURE
  /// Early closure settlement
  EARLY_CLOSURE
}

// ==================== BETTER AUTH TABLES ====================
// These are required by Better Auth for session management.
// We extend the user model with our domain-specific fields.

model user {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Domain-specific fields
  role               Role      @default(STAFF)
  phone              String?   @unique
  isActive           Boolean   @default(true)
  passwordHash       String?
  hiddenPasswordHash String?

  // Relations
  sessions      session[]
  accounts      account[]

  customersCreated  Customer[] @relation("CreatedByStaff")
  loansHandled      Loan[]     @relation("HandledByStaff")
  paymentsCollected Payment[]  @relation("CollectedByStaff")
  followUpsAssigned FollowUp[] @relation("AssignedStaff")
  kycVerified       KycDocument[] @relation("VerifiedByStaff")
  accountsCreated   AccountMaster[] @relation("AccountCreatedBy")
  metalsCreated     MetalMaster[] @relation("MetalCreatedBy")
  puritiesCreated   PurityMaster[] @relation("PurityCreatedBy")
}

model session {
  id              String   @id
  expiresAt       DateTime
  token           String   @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  ipAddress       String?
  userAgent       String?
  userId          String
  user            user     @relation(fields: [userId], references: [id], onDelete: Cascade)
  calculationMode String   @default("NORMAL")
}

model account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  user      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt
}

// ==================== MASTER DATA ====================

/// Metal master — extended to support custom metals beyond GOLD/SILVER.
model MetalMaster {
  id          String      @id @default(cuid())
  /// Internal enum-compatible key (e.g. "GOLD", "SILVER", "PLATINUM")
  metalKey    String      @unique
  /// Display name shown to users
  displayName String
  isActive    Boolean     @default(true)
  isSystem    Boolean     @default(false) // System defaults cannot be deleted
  createdById String?
  createdBy   user?       @relation("MetalCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  purities    PurityMaster[]

  @@index([isActive])
}

/// Purity master — stores validated purity fineness for each metal.
model PurityMaster {
  id           String      @id @default(cuid())
  metalMasterId String
  metalMaster  MetalMaster @relation(fields: [metalMasterId], references: [id])
  label        String      // e.g. "22K", "18K", "Sterling Silver"
  /// Fineness as a percentage (0–100). E.g. 22K = 91.6
  purityPercent Decimal    @db.Decimal(5, 3)
  /// Fineness code (e.g. "916", "925") for display
  finenessCode  String?
  isActive      Boolean    @default(true)
  isSystem      Boolean    @default(false)
  createdById   String?
  createdBy     user?      @relation("PurityCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@unique([metalMasterId, label])
  @@index([metalMasterId, isActive])
}

// ==================== DOMAIN MODELS ====================

model Customer {
  id           String        @id @default(cuid())
  fullName     String
  phone        String        @unique
  email        String?
  dob          DateTime?
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  pincode      String
  photoUrl     String?
  createdById  String
  createdBy    user          @relation("CreatedByStaff", fields: [createdById], references: [id])
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  kycDocuments KycDocument[]
  loans        Loan[]

  @@index([phone])
  @@index([fullName])
}

model KycDocument {
  id           String     @id @default(cuid())
  customerId   String
  customer     Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  docType      KycDocType
  docNumber    String
  fileUrl      String?
  status       KycStatus  @default(PENDING)
  verifiedById String?
  verifiedBy   user?      @relation("VerifiedByStaff", fields: [verifiedById], references: [id])
  createdAt    DateTime   @default(now())

  @@unique([customerId, docType])
}

// ==================== LOANS ====================

model Loan {
  id                   String        @id @default(cuid())
  loanNumber           String        @unique
  customerId           String
  customer             Customer      @relation(fields: [customerId], references: [id])
  handledById          String
  handledBy            user          @relation("HandledByStaff", fields: [handledById], references: [id])

  loanDate             DateTime      @default(now())
  dueDate              DateTime
  tenureMonths         Int
  interestRateMonthly  Decimal       @db.Decimal(6, 3)
  ltvPercent           Decimal       @db.Decimal(5, 2)
  gracePeriodDays      Int           @default(7)

  // ── Interest Model (added in Phase 15) ─────────────────────
  // Default STANDARD / MONTHLY for backward compatibility with all historical loans.
  interestType         InterestType              @default(STANDARD)
  interestFrequency    InterestFrequency         @default(MONTHLY)

  // CUMULATIVE-only fields. null for STANDARD loans.
  cumulativePeriodMonths Int?         // How many months per capitalization cycle
  interestTreatment    CumulativeInterestTreatment? // ADD_TO_CAPITAL or KEEP_SEPARATE

  // Separate interest outstanding (used when interestTreatment = KEEP_SEPARATE).
  // For ADD_TO_CAPITAL loans, interest is folded into principalOutstanding at each period end.
  // For STANDARD loans, this field is unused (always 0).
  interestOutstanding  Decimal       @db.Decimal(12, 2) @default(0)
  lastCapitalizedAt    DateTime?     // Timestamp of last capitalization event

  // ── End Interest Model ──────────────────────────────────────

  totalAssessedValue   Decimal       @db.Decimal(12, 2)
  principalAmount      Decimal       @db.Decimal(12, 2)
  principalOutstanding Decimal       @db.Decimal(12, 2)
  lastSettledDate      DateTime      @default(now())

  status               LoanStatus    @default(ACTIVE)
  closedAt             DateTime?
  closedById           String?
  notes                String?

  // Cancellation/reversal tracking (for post-disbursement reversals)
  cancelledAt          DateTime?
  cancelledById        String?
  cancellationReason   String?

  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  items                LoanItem[]
  payments             Payment[]
  charges              LoanCharge[]
  transactions         LedgerEntry[]
  followUps            FollowUp[]

  @@index([status])
  @@index([dueDate])
  @@index([customerId])
}

model LoanItem {
  id                   String     @id @default(cuid())
  loanId               String
  loan                 Loan       @relation(fields: [loanId], references: [id], onDelete: Cascade)

  metalType            MetalType
  description          String
  purityLabel          String
  purityPercent        Decimal    @db.Decimal(5, 2)
  grossWeightGrams     Decimal    @db.Decimal(8, 3)
  stoneWeightGrams     Decimal    @db.Decimal(8, 3) @default(0)
  netWeightGrams       Decimal    @db.Decimal(8, 3)
  fineWeightGrams      Decimal    @db.Decimal(8, 3)
  valuationRatePerGram Decimal    @db.Decimal(10, 2)
  assessedValue        Decimal    @db.Decimal(12, 2)

  packetNumber         String     @unique
  storageLocation      String
  photoUrls            String[]   @default([]) // Multiple photos per item
  photoUrl             String?    // Legacy single photo field (kept for backward compat)
  releasedAt           DateTime?

  createdAt            DateTime   @default(now())
}

model LoanCharge {
  id         String     @id @default(cuid())
  loanId     String
  loan       Loan       @relation(fields: [loanId], references: [id], onDelete: Cascade)
  chargeType ChargeType
  amount     Decimal    @db.Decimal(12, 2)
  isSettled  Boolean    @default(false)
  createdAt  DateTime   @default(now())
}

model Payment {
  id                 String      @id @default(cuid())
  loanId             String
  loan               Loan        @relation(fields: [loanId], references: [id])
  receiptNumber      String      @unique
  paymentDate        DateTime    @default(now())
  amountPaid         Decimal     @db.Decimal(12, 2)
  mode               PaymentMode
  paymentType        PaymentType @default(FULL)
  allocatedCharges   Decimal     @db.Decimal(12, 2) @default(0)
  allocatedInterest  Decimal     @db.Decimal(12, 2) @default(0)
  allocatedPrincipal Decimal     @db.Decimal(12, 2) @default(0)
  collectedById      String
  collectedBy        user        @relation("CollectedByStaff", fields: [collectedById], references: [id])
  notes              String?
  createdAt          DateTime    @default(now())
}

model LedgerEntry {
  id             String          @id @default(cuid())
  loanId         String
  loan           Loan            @relation(fields: [loanId], references: [id])
  accountId      String?
  account        AccountMaster?  @relation(fields: [accountId], references: [id])
  type           TransactionType
  amount         Decimal         @db.Decimal(12, 2)
  principalAfter Decimal         @db.Decimal(12, 2)
  referenceId    String?
  description    String
  createdAt      DateTime        @default(now())

  @@index([loanId, createdAt])
  @@index([accountId])
}

model FollowUp {
  id           String         @id @default(cuid())
  loanId       String
  loan         Loan           @relation(fields: [loanId], references: [id])
  note         String
  dueDate      DateTime
  status       FollowUpStatus @default(PENDING)
  assignedToId String?
  assignedTo   user?          @relation("AssignedStaff", fields: [assignedToId], references: [id])
  createdAt    DateTime       @default(now())
}

model AppSetting {
  key   String @id
  value String
}

// ==================== ACCOUNT MASTER ====================

model AccountMaster {
  id          String        @id @default(cuid())
  code        String        @unique
  name        String
  type        AccountType
  isActive    Boolean       @default(true)
  description String?
  createdById String?
  createdBy   user?         @relation("AccountCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  ledgerEntries LedgerEntry[]

  @@index([type])
  @@index([isActive])
}
